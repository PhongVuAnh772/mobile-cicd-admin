default_platform(:android)

platform :android do

  # ============================================================================
  # 🌿 HELPER FUNCTIONS — Xử lý tên nhánh & quy tắc đặt tên file
  # ============================================================================
  def get_clean_branch_slug
    raw_branch = ENV['GITHUB_REF_NAME'] || ENV['GIT_BRANCH'] || Actions.git_branch || "local"
    # Chuyển đổi feature/login -> feature-login, xóa ký tự đặc biệt
    raw_branch.gsub(/[^a-zA-Z0-9_\-]/, '-').downcase
  end

  def get_app_version
    # Đọc version từ package.json
    begin
      package_json = JSON.parse(File.read("../package.json"))
      package_json["version"] || "1.0.0"
    rescue
      "1.0.0"
    end
  end

  def get_build_number
    ENV['GITHUB_RUN_NUMBER'] || ENV['BUILD_NUMBER'] || "1"
  end

  # ============================================================================
  # 🌿 LANE :FEATURE / :BUGFIX — Dành cho các nhánh feature/*, bugfix/*
  # Quy tắc: app-{branch_slug}-b{build_number}.apk
  # ============================================================================
  desc "🌿 FEATURE / BUGFIX: Build APK đính kèm tên nhánh để test nội bộ"
  lane :feature do
    branch_slug = get_clean_branch_slug
    build_num = get_build_number
    version = get_app_version

    UI.header("🚀 Bắt đầu build Feature Branch: #{branch_slug}")

    gradle(
      task: "assembleRelease",
      project_dir: "android"
    )

    # Đổi tên file APK theo quy tắc chuẩn
    original_apk = Dir.glob("android/app/build/outputs/apk/release/*.apk").first
    if original_apk
      custom_apk_name = "app-#{branch_slug}-v#{version}-b#{build_num}.apk"
      custom_apk_path = "android/app/build/outputs/apk/release/#{custom_apk_name}"
      FileUtils.cp(original_apk, custom_apk_path)
      UI.success("✅ Đã tạo file APK theo Branch Rule: #{custom_apk_name}")
    end
  end

  # ============================================================================
  # 📲 LANE :STAGING — Dành cho nhánh dev / staging
  # Quy tắc: app-staging-v{version}-b{build_number}.apk & .aab
  # Đẩy S3 Store & Google Play Internal Testing Track
  # ============================================================================
  desc "📲 STAGING: Build APK + AAB và upload Google Play Internal Track"
  lane :staging do
    version = get_app_version
    build_num = get_build_number

    UI.header("🚀 Build Staging Release v#{version} (Build ##{build_num})")

    gradle(
      tasks: ["assembleRelease", "bundleRelease"],
      project_dir: "android"
    )

    # Đổi tên file APK Staging
    original_apk = Dir.glob("android/app/build/outputs/apk/release/*.apk").first
    if original_apk
      staging_apk_name = "app-staging-v#{version}-b#{build_num}.apk"
      FileUtils.cp(original_apk, "android/app/build/outputs/apk/release/#{staging_apk_name}")
      UI.success("✅ Đã gắn nhãn Staging APK: #{staging_apk_name}")
    end

    # Tùy chọn upload Google Play Internal Track nếu có Service Account JSON
    if ENV['GPLAY_SERVICE_ACCOUNT_JSON'] || File.exist?("service_account.json")
      upload_to_play_store(
        track: "internal",
        aab: "android/app/build/outputs/bundle/release/app-release.aab",
        skip_upload_screenshots: true,
        skip_upload_metadata: true
      )
      UI.success("🎉 Đã đẩy bản Staging lên Google Play Internal Testing Track!")
    else
      UI.important("ℹ️ Bỏ qua Google Play upload (chưa cấu hình GPLAY_SERVICE_ACCOUNT_JSON).")
    end
  end

  # ============================================================================
  # 🏪 LANE :PRODUCTION — Dành cho nhánh main / tags v*.*.*
  # Quy tắc: app-v{version}.aab
  # Đẩy Google Play Console Production Track (Draft / Staged Rollout)
  # ============================================================================
  desc "🏪 PRODUCTION: Build AAB chính thức & Đẩy lên Google Play Console (Draft)"
  lane :production do
    version = get_app_version
    build_num = get_build_number

    UI.header("👑 Build Official Production Release v#{version}")

    gradle(
      task: "bundleRelease",
      project_dir: "android"
    )

    if ENV['GPLAY_SERVICE_ACCOUNT_JSON'] || File.exist?("service_account.json")
      upload_to_play_store(
        track: "production",
        aab: "android/app/build/outputs/bundle/release/app-release.aab",
        release_status: "draft",       # An toàn: Tạo bản Draft để Admin duyệt trước khi Publish
        skip_upload_screenshots: true,
        skip_upload_metadata: true
      )
      UI.success("🎉 Đã tạo bản Draft Production Release trên Google Play Console!")
    else
      UI.important("ℹ️ AAB đã sẵn sàng tại android/app/build/outputs/bundle/release/app-release.aab")
    end
  end

  # ============================================================================
  # 🎯 LANE :AUTO_BY_BRANCH — Tự động chọn Lane phù hợp dựa theo tên Branch
  # ============================================================================
  desc "🎯 AUTO: Tự động điều hướng Lane theo tên nhánh Git"
  lane :auto_by_branch do
    raw_branch = ENV['GITHUB_REF_NAME'] || Actions.git_branch || "main"
    
    if raw_branch == "main" || raw_branch.start_with?("release/") || raw_branch.start_with?("v")
      production
    elsif raw_branch == "dev" || raw_branch == "staging"
      staging
    else
      feature
    end
  end

end
