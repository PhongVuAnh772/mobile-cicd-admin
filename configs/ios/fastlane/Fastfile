default_platform(:ios)

platform :ios do

  def get_workspace
    Dir.glob("*.xcworkspace").first || Dir.glob("../ios/*.xcworkspace").first || "{{PROJECT_NAME}}.xcworkspace"
  end

  def get_scheme
    xcodeproj = Dir.glob("*.xcodeproj").first || Dir.glob("../ios/*.xcodeproj").first
    xcodeproj ? File.basename(xcodeproj, ".xcodeproj") : "{{PROJECT_NAME}}"
  end

  # ============================================================================
  # 🚀 FIRST RELEASE — Chỉ dùng khi app CHƯA CÓ trên App Store
  # ============================================================================
  # Lần đầu: tạo Certificate + Profile mới, upload TẤT CẢ (binary + metadata + screenshots)
  # submit_for_review: false ➔ Chờ team kiểm tra thủ công trên App Store Connect
  # automatic_release: false ➔ Khi Apple approve, KHÔNG tự phát hành
  # ============================================================================
  desc "🚀 FIRST RELEASE: Khởi tạo Certificate, Build IPA, Upload toàn bộ lần đầu"
  lane :first_release do
    # Lần đầu PHẢI chạy match KHÔNG readonly để tạo Certificate + Profile
    match(type: "appstore", readonly: false)

    build_app(
      workspace: get_workspace,
      scheme: get_scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build"
    )

    deliver(
      submit_for_review: false,    # ⚠️ KHÔNG tự submit — kiểm tra thủ công trước
      automatic_release: false,    # ⚠️ KHÔNG tự phát hành khi Apple duyệt
      force: true,                 # Bỏ qua xác nhận HTML preview
      skip_metadata: false,        # ✅ Upload metadata (tên app, mô tả, keywords...)
      skip_screenshots: false,     # ✅ Upload screenshots (bắt buộc lần đầu)
      phased_release: false,       # ❌ Lần đầu KHÔNG phased rollout — phát hành 100%
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false
    )

    UI.success("✅ First Release iOS hoàn tất!")
    UI.important("👉 Vào App Store Connect để kiểm tra và bấm Submit for Review")
  end

  # ============================================================================
  # 🔄 UPDATE RELEASE — Dùng cho các bản cập nhật định kỳ sau lần đầu
  # ============================================================================
  # Sau lần đầu: sync Certificate readonly, auto version bump, tự submit review
  # phased_release: true ➔ Phát hành dần từ 1% → 100% trong 7 ngày
  # ============================================================================
  desc "🔄 UPDATE RELEASE: Tăng version, build & submit tự động cho các bản cập nhật"
  lane :update_release do
    # Sync Certificate readonly (đã tạo từ first_release)
    match(type: "appstore", readonly: true)

    # Tăng build number tự động
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: Dir.glob("*.xcodeproj").first || "{{PROJECT_NAME}}.xcodeproj"
    )

    build_app(
      workspace: get_workspace,
      scheme: get_scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build"
    )

    deliver(
      submit_for_review: true,     # ✅ Tự submit cho Apple review
      automatic_release: true,     # ✅ Tự phát hành khi Apple duyệt
      force: true,
      skip_metadata: true,         # ⏭️ Bỏ qua metadata (đã có từ lần đầu)
      skip_screenshots: true,      # ⏭️ Bỏ qua screenshots (đã có từ lần đầu)
      phased_release: true,        # ✅ Phát hành dần 1% → 2% → 5% → ... → 100%
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false
    )

    # Commit version bump
    commit_version_bump(message: "chore(release): iOS version bump [skip ci]")
    push_to_git_remote

    UI.success("🔄 Update Release iOS hoàn tất — Phased Rollout đã kích hoạt!")
  end

  # ============================================================================
  # 📲 AD-HOC BUILD — Dùng cho môi trường Dev & Feature branches
  # ============================================================================
  desc "📲 AD-HOC: Build IPA đẩy lên AWS S3 (Dev/Feature test)"
  lane :adhoc_aws do
    match(type: "adhoc", readonly: true)

    build_app(
      workspace: get_workspace,
      scheme: get_scheme,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "build"
    )
  end

  # ============================================================================
  # 📤 UPLOAD SYMBOLS — dSYM cho Crashlytics & Sentry
  # ============================================================================
  desc "📤 Upload dSYM symbols lên Crashlytics & Sentry"
  lane :upload_symbols do
    download_dsyms
    upload_symbols_to_crashlytics
    sentry_upload_dsym
  end

  # ============================================================================
  # 🚀 LANE :APP_DISTRIBUTION — Phân phối IPA lên OTA Distribution Server
  # ============================================================================
  desc "🚀 APP_DISTRIBUTION: Đóng gói IPA và đẩy lên OTA Distribution Server kèm metadata"
  lane :app_distribution do
    build_env = ENV['BUILD_ENV'] || "DEV"
    flavor = ENV['FLAVOR'] || build_env.downcase
    message = ENV['MESSAGE'] || ENV['M'] || "Bản build iOS #{build_env}"
    author = ENV['AUTHOR'] || Actions.git_author || "Developer"
    branch = ENV['REF_NAME'] || Actions.git_branch || "main"
    server_url = ENV['OTA_SERVER_URL'] || ENV['BASE_URL'] || "http://localhost:3000"

    # Tìm file IPA có sẵn hoặc đóng gói bằng gym/build_app
    ipa_files = Dir.glob("build/*.ipa") +
                Dir.glob("*.ipa") +
                Dir.glob("../ios/build/*.ipa") +
                Dir.glob("../build/*.ipa")
    ipa_path = ipa_files.first

    unless ipa_path
      UI.header("🔨 Đang đóng gói IPA bằng gym/build_app...")
      build_app(
        export_method: "ad-hoc",
        output_directory: "build"
      )
      ipa_path = Dir.glob("build/*.ipa").first
    end

    UI.user_error!("❌ Không tìm thấy file .ipa để phân phối!") unless ipa_path

    UI.header("🚀 Đang đẩy IPA lên OTA Distribution: #{server_url}...")
    UI.message("📦 File:     #{ipa_path}")
    UI.message("🌍 Env:      #{build_env} (Flavor: #{flavor})")
    UI.message("💬 Message:  #{message}")
    UI.message("👤 Author:   #{author}")

    sh(
      "curl", "-s", "-X", "POST", "#{server_url}/api/ota/upload",
      "-F", "file=@#{ipa_path}",
      "--form-string", "environment=#{build_env.downcase}",
      "--form-string", "flavor=#{flavor}",
      "--form-string", "message=#{message}",
      "--form-string", "author=#{author}",
      "--form-string", "branch=#{branch}"
    )
    UI.success("🎉 Đã phân phối bản IPA (#{build_env}) lên OTA Portal thành công!")
  end

  # ============================================================================
  # ✈️ LANE :BETA_TESTFLIGHT — Upload lên TestFlight cho Tester & QA
  # ============================================================================
  desc "✈️ BETA_TESTFLIGHT: Build & Upload IPA lên Apple TestFlight"
  lane :beta_testflight do
    if ENV['APP_STORE_CONNECT_API_KEY_KEY']
      app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY']
      )
    end

    ipa_files = Dir.glob("build/*.ipa") + Dir.glob("*.ipa")
    ipa_path = ipa_files.first

    unless ipa_path
      UI.header("🔨 Đang đóng gói IPA cho TestFlight...")
      build_app(
        workspace: get_workspace,
        scheme: get_scheme,
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build"
      )
      ipa_path = Dir.glob("build/*.ipa").first
    end

    UI.user_error!("❌ Không tìm thấy file .ipa để upload TestFlight!") unless ipa_path

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      changelog: ENV['MESSAGE'] || "Bản cập nhật TestFlight từ CI/CD"
    )
    UI.success("🎉 Đã đẩy IPA lên TestFlight thành công!")
  end

  # ============================================================================
  # 📸 SCREENSHOTS — Chụp ảnh tự động đa thiết bị
  # ============================================================================
  desc "📸 Chụp ảnh màn hình tự động bằng Snapshot"
  lane :take_screenshots do
    snapshot
  end
end
